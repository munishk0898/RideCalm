    <string name="mode_title">Show Motion Cues</string>
    <string name="mode_off">Off</string>
    <string name="mode_on">On</string>
    <string name="mode_automatic">Automatic</string>
    <string name="mode_desc_off">Motion cues are off.</string>
    <string name="mode_desc_on">Dots are shown over all apps until you turn them off.</string>
    <string name="mode_desc_automatic">Dots appear when the phone senses you are riding in a vehicle and hide when you start walking or the vehicle stays parked. Detection runs on this phone only, while the screen is on.</string>
    <string name="pattern_title">Pattern</string>
    <string name="pattern_regular">Regular</string>
