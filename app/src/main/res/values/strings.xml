    <!-- Permissions -->
    <string name="perm_overlay_title">Display over other apps</string>
    <string name="perm_overlay_body">Required to draw the dots on top of other apps, videos and games. Touches still pass through.</string>
    <string name="perm_notifications_title">Notifications</string>
    <string name="perm_notifications_body">Lets the app show a status notification with a quick Turn off button while cues are running.</string>
    <string name="perm_activity_title">Physical activity</string>
    <string name="perm_activity_body">Optional. Lets Automatic mode use the step counter to tell walking from riding more reliably. Step data stays on this phone.</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_body">RideCalm works completely offline. It has no internet permission, uses no Google services, collects no analytics and is excluded from cloud backup. Sensor readings are processed in memory and never stored; only your settings are saved on this phone.</string>
    <string name="perm_allow">Allow</string>
    <string name="perm_open_settings">Open settings</string>
    <string name="sensors_missing">This device has no motion sensors, so motion cues cannot follow the vehicle.</string>
    <string name="status_running">Running</string>
