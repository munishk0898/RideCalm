    <string name="app_name">RideCalm</string>
    <string name="screen_title">RideCalm</string>
    <string name="screen_intro">Animated dots at the edges of the screen follow the vehicle\'s movement, which can reduce motion sickness when you look at your phone as a passenger.</string>

    <!-- Quick Settings tile -->
    <string name="tile_label">RideCalm</string>
    <string name="tile_add">Add to Quick Settings</string>

