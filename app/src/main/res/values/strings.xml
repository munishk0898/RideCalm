    <string name="notification_active">Showing motion cues</string>
    <string name="notification_waiting">Automatic: waiting for vehicle motion</string>
    <string name="notification_needs_overlay">Allow \"Display over other apps\" to show the dots</string>
    <string name="notification_turn_off">Turn off</string>

